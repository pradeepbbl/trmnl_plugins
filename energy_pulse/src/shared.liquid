{%- comment -%}
Shared across every view. `transform.py` guarantees the shape used below:
ok, hours[], stats{}, tomorrow{}, unit_label, zone_label, date_label.
{%- endcomment -%}

{%- assign price_unit = trmnl.plugin_settings.custom_fields_values.price_unit -%}
{%- if price_unit == "currency_mwh" -%}
  {%- assign unit_note = "wholesale, per MWh" -%}
{%- else -%}
  {%- assign unit_note = "wholesale, excl. grid fees" -%}
{%- endif -%}

{%- comment -%} "off" or "no" in the usage_examples field hides the cost row entirely. {%- endcomment -%}
{%- assign usage_setting = trmnl.plugin_settings.custom_fields_values.usage_examples | strip | downcase -%}
{%- assign show_usages = true -%}
{%- if usage_setting == "off" or usage_setting == "no" -%}
  {%- assign show_usages = false -%}
{%- endif -%}

{%- comment -%}
  Shared title bar across every view. Pass `ok` and a pre-formatted `instance`
  string (each view controls how much detail — zone/date/updated_at — fits).
{%- endcomment -%}
{% template title_bar %}
<div class="title_bar">
  <span class="title">Day-Ahead Prices</span>
  {% if ok %}
    <span class="instance">{{ instance }}</span>
  {% endif %}
</div>
{% endtemplate %}

{%- capture no_data -%}
<div class="layout layout--col layout--center gap--small">
  {% if data_age_hours and data_age_hours < 24 %}
    <span class="title title--large lg:title--xxlarge text--center">ENTSO-E hasn't published today's prices yet</span>
  {% else %}
    <span class="title title--large lg:title--xxlarge text--center">No price data available</span>
  {% endif %}
  {% if error_detail %}
    <span class="label label--large lg:label--xxlarge label--gray text--center">{{ error_detail }}</span>
  {% elsif data_age_hours %}
    <span class="label label--large lg:label--xxlarge label--gray text--center">
      Last known data from {{ data_age_hours | round }}h ago — check back shortly
    </span>
    <div class="flex flex--row flex--center-x flex--center-y gap--xsmall">
      <img class="image image--small" src="https://qrtag.net/api/qr_6.png?url={{ 'https://transparency.entsoe.eu/news' | url_encode }}" alt="QR code to ENTSO-E news">
     <span class="label label--gray 1bit:text--black">Scan for ENTSO-E status updates</span>
    </div>
  {% else %}
    <span class="label label--large lg:label--xxlarge label--gray text--center">
      Couldn't load price data. Check plugin settings or try again shortly.
    </span>
  {% endif %}
</div>
{%- endcapture -%}

{%- comment -%}
  Inline monochrome SVGs for the usage-cost icons (full view only). The device
  is 1-bit e-ink — photos and emoji (the framework font ships no emoji glyphs
  yet) don't render reliably at this size, so these are hand-drawn line icons
  baked into the markup: no network fetch, no lint failures, crisp at 22px.
{%- endcomment -%}
{%- capture icon_shower -%}
<svg viewBox="0 0 24 24" width="48" height="48" fill="currentColor">
  <path d="M4 8h12a4 4 0 0 1 4 4H4V8z"/>
