{% if ok == false or hours.size == 0 %}
{{ no_data }}
{% else %}
<div class="layout layout--col layout--stretch-x gap--space-between">

  <div class="flex flex--row flex--between flex--bottom">
    <div class="flex flex--col flex--left">
      <span class="label label--gray 1bit:text--black">Now · {{ stats.now_time }}</span>
      <span class="value value--large value--tnums">{{ stats.now_display }}</span>
    </div>
    <span class="label label--gray 1bit:text--black">{{ unit_label }}</span>
  </div>

  {% assign chart_id = "price-chart-q" | append_random %}
  <div id="{{ chart_id }}" class="w--full grow h--min-[100px]"></div>
  <script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
  <script>
    (function() {
      var chartData = [
        {% for h in hours %}{
          y: {{ h.price }},
     category: '{% if h.is_now %}now{% elsif h.is_past %}past{% else %}future{% endif %}'
    }{% unless forloop.last %},{% endunless %}{% endfor %}
    ];

    function buildChart(useTRMNL) {
      var el = '{{ chart_id }}';
      var nowColor, futureColor, pastColor;

      if (useTRMNL) {
        nowColor = TRMNLCharts.series(0, 3, { el: el });
        futureColor = TRMNLCharts.series(1, 3, { el: el });
        pastColor = TRMNLCharts.series(2, 3, { el: el });
      } else {
        nowColor = '#000000';
        futureColor = '#888888';
        pastColor = '#CCCCCC';
      }

      var coloredData = chartData.map(function(d) {
        var color;
        if (d.category === 'now') color = nowColor;
        else if (d.category === 'past') color = pastColor;
        else color = futureColor;
        return { y: d.y, color: color };
      });

      var chartOpts = {
        chart: { type: 'column', height: null, backgroundColor: 'transparent', spacing: [2, 0, 0, 0], animation: false },
        title: { text: null },
        accessibility: { enabled: false },
        legend: { enabled: false },
        credits: { enabled: false },
        xAxis: { categories: false, labels: { enabled: false }, lineWidth: 0, tickLength: 0 },
        yAxis: { title: { text: null }, labels: { enabled: false }, gridLineWidth: 0 },
        tooltip: { enabled: false },
        plotOptions: { series: { animation: false }, column: { borderWidth: 0, pointPadding: 0.02, groupPadding: 0.02, minPointLength: 2 } },
        series: [{ data: coloredData }]
      };

      if (useTRMNL) {
        return Highcharts.chart(el, TRMNLCharts.merge(TRMNLCharts.options({ el: el }), chartOpts));
      }
      return Highcharts.chart(el, chartOpts);
    }

    function whenReady(cb) {
      var tries = 0;
      (function attempt() {
        if (window.Highcharts) {
          if (window.TRMNLCharts) {
            TRMNLCharts.watch('{{ chart_id }}', function() { return cb(true); });
          } else if (tries > 40) {
            cb(false);
          } else {
            if (++tries > 200) return;
            setTimeout(attempt, 50);
          }
          return;
        }
        if (++tries > 200) return;
        setTimeout(attempt, 50);
      })();
    }

    whenReady(buildChart);
    })();
  </script>

  <div class="flex flex--row flex--between">
    <span class="label">Low {{ stats.min_display }} · {{ stats.min_time }}</span>
    <span class="label">Peak {{ stats.max_display }} · {{ stats.max_time }}</span>
  </div>

</div>
{% endif %}

{% render 'title_bar', ok: ok, instance: zone_label | default: "Data unavailable" %}
